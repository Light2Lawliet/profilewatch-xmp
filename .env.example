# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
PROFILEWATCH_HEALTH_THRESHOLD=60
PROFILEWATCH_ANCHOR_DATE=2026-08-14
PROFILEWATCH_RESPONSE_RATE_OPPORTUNITY_THRESHOLD=50
PROFILEWATCH_SLOW_RESPONSE_DAYS_THRESHOLD=3
PROFILEWATCH_RESPONSE_QUALITY_THRESHOLD=50
PROFILEWATCH_VELOCITY_INCIDENT_THRESHOLD=30
PROFILEWATCH_VELOCITY_OPPORTUNITY_THRESHOLD=40
# Deployment: comma-separated UI origins allowed by CORS (default "*")
PROFILEWATCH_ALLOWED_ORIGINS=https://your-site.netlify.app
# Deployment: shared key required (X-Access-Key header) for AI + admin endpoints; unset = no check
PROFILEWATCH_ACCESS_KEY=
PROFILEWATCH_AI_RATE_LIMIT_PER_HOUR=30

# Account data lives in Supabase (Settings > API in your Supabase project),
# not in this repo. Server-side only — never expose the service_role key to
# the browser.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
